---
import "../../../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Privacy policy for Santra Sheti Margdarshak, a free offline farming guide app."
    />
    <title>Privacy Policy — Santra Sheti Margdarshak</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased bg-[var(--gray-900)]">
    <div
      class="sticky top-0 z-50 bg-[var(--gray-900)]/90 backdrop-blur-md border-b border-[var(--gray-700)] py-3">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <a href="/" class="text-sm font-semibold text-[var(--emerald-400)] hover:underline">
          ← Back to Portfolio
        </a>
      </div>
    </div>

    <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-10 max-w-3xl">
      <p class="text-xs font-semibold tracking-wider uppercase text-[var(--emerald-400)] mb-2">
        गोपनीयता धोरण
      </p>
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--gray-100)]">Privacy Policy</h1>
      <p class="text-[var(--gray-400)] italic mt-1 mb-6">
        Santra Sheti Margdarshak — संत्रा शेती मार्गदर्शक
      </p>

      <div
        class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-[var(--gray-400)] border-y border-[var(--gray-700)] py-3 mb-8">
        <span
          >Last updated: <span class="text-[var(--gray-200)] font-medium"
            >2 October 2026</span
          ></span
        >
        <span
          >Applies to: <span class="text-[var(--gray-200)] font-medium"
            >Santra Sheti Margdarshak</span
          > Android app</span
        >
      </div>

      <div class="space-y-8 text-[var(--gray-300)] leading-relaxed">
        <p>
          Santra Sheti Margdarshak ("the app") is a free, offline farming reference guide
          built to help orange (santra) farmers in Vidarbha, Maharashtra access reliable
          cultivation information in Marathi.
        </p>

        <section>
          <h2 class="text-xl font-semibold text-[var(--gray-100)] mb-2">
            Information We Collect
          </h2>
          <p class="mb-3">
            We do not collect, store, or share any personal information. The app requires
            no account, no login, and no personal details to use.
          </p>
          <p>
            All chapters, photos, the pest/disease guide, FAQ, and search run entirely on
            your device and work fully offline. We have no servers, and we have no
            visibility into how you use the app.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-[var(--gray-100)] mb-2">Internet Access</h2>
          <p class="mb-3">
            The app requests internet access for one feature only: the "माहितीपर व्हिडिओ"
            (reference videos) section, which plays curated YouTube videos inside the app.
            When you watch a video there, your connection goes to YouTube/Google, and <a
              href="https://policies.google.com/privacy"
              class="text-[var(--emerald-400)] hover:underline">YouTube's own Privacy Policy</a
            > applies to that interaction. We receive no data from this.
          </p>
          <div
            class="bg-[var(--gray-800)] border-l-2 border-[var(--emerald-500)] rounded-md px-4 py-3 text-sm">
            If you never open the video section, the app makes no network connections at all.
          </div>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-[var(--gray-100)] mb-2">
            Advertising and Analytics
          </h2>
          <p>
            This app contains no advertisements, no analytics, and no third-party tracking
            of any kind.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-[var(--gray-100)] mb-2">Children</h2>
          <p>
            The app is intended for a general/adult audience (farmers and agricultural
            readers) and is not directed at children.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-[var(--gray-100)] mb-2">
            Changes to This Policy
          </h2>
          <p>
            If this policy changes, the update will be posted on this page with a new
            "last updated" date.
          </p>
        </section>
      </div>

      <footer class="mt-12 pt-6 border-t border-[var(--gray-700)] text-sm text-[var(--gray-400)]">
        <p class="font-semibold text-[var(--gray-200)] mb-1">Santra Sheti Margdarshak</p>
        <p>
          Questions about this policy: <a
            href="mailto:sanketjadhao2002@gmail.com"
            class="text-[var(--emerald-400)] hover:underline">sanketjadhao2002@gmail.com</a
          >
        </p>
      </footer>
    </main>
  </body>
</html>
