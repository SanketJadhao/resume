---
import "../styles/global.css";
import { experiences } from "../data/experience";
import { education, researchPaper } from "../data/education";
import { projects } from "../data/projects";
import { skills } from "../data/skills";

const academicProjects = projects.filter((p) => p.category === "University Project");

const skillGroups = [
  { label: "Languages", items: skills.languages },
  { label: "Web/Mobile", items: skills.webAndMobile },
  { label: "Databases", items: skills.databases },
  { label: "ML/DS", items: skills.mlAndDataScience },
  { label: "Tools", items: skills.tools },
];

// The one-page PDF version of this resume, served from public/.
const pdfPath = "/Sanket_Jadhao_Resume.pdf";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sanket Jadhao's resume" />
    <title>Sanket Jadhao - Resume</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased bg-[var(--gray-900)]">
    <!-- Floating pill bar, matching the main site's header. -->
    <div class="no-print fixed top-3 inset-x-0 z-50 px-3">
      <div
        class="container mx-auto max-w-4xl flex items-center justify-between h-14 pl-2 pr-2 rounded-full bg-[#161616]/70 backdrop-blur-xl border border-white/10">
        <a
          href="/"
          class="flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium text-[var(--gray-300)] hover:bg-white/10 hover:text-white transition-colors">
          &larr; Portfolio
        </a>
        <a
          href={pdfPath}
          download="Sanket_Jadhao_Resume.pdf"
          class="flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-black text-sm font-medium hover:bg-[var(--gray-200)] transition-colors">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Download PDF
        </a>
      </div>
    </div>

    <main class="resume-doc container mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-24 max-w-4xl">
      <header class="mb-14">
        <h1 class="text-5xl md:text-7xl font-medium text-white leading-[0.95]">Sanket Jadhao</h1>
        <p class="text-3xl md:text-5xl font-medium text-[var(--gray-600)] leading-[0.95] mt-1">
          Software Engineer.
        </p>
        <div class="flex flex-wrap gap-2 mt-8 text-sm">
          <span class="resume-pill">Gainesville, FL (Relocatable)</span>
          <a href="mailto:sanketjadhao2002@gmail.com" class="resume-pill hover:bg-white/10"
            >sanketjadhao2002@gmail.com</a
          >
          <a
            href="https://linkedin.com/in/sanket-jadhao/"
            target="_blank"
            rel="noopener noreferrer"
            class="resume-pill hover:bg-white/10">LinkedIn &nearr;</a
          >
        </div>
      </header>

      <section class="mb-14">
        <h2 class="resume-label">Introduction</h2>
        <p class="text-xl md:text-2xl text-[var(--gray-200)] leading-snug">
          Software Engineer with a Master's in Computer Science from University of Florida.
          Shipped production work across mobile, backend, and full-stack. Comfortable across
          Flutter, Kotlin, Python, and Golang. Looking for roles where engineering directly
          drives product outcomes.
        </p>
      </section>

      <section class="mb-14">
        <h2 class="resume-label">Professional Experience</h2>
        <div class="space-y-4">
          {
            experiences.map((exp) => (
              <article class="resume-card">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-4">
                  <div>
                    <h3 class="text-2xl font-medium text-white">{exp.company}</h3>
                    <p class="text-[var(--gray-300)]">
                      {exp.role} <span class="text-[var(--gray-500)]">· {exp.location}</span>
                    </p>
                  </div>
                  <span class="text-sm text-[var(--gray-500)] whitespace-nowrap">{exp.period}</span>
                </div>
                <ul class="list-disc list-outside pl-5 space-y-2 text-[var(--gray-400)] marker:text-[var(--gray-600)]">
                  {exp.descriptionPoints.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class="mb-14">
        <h2 class="resume-label">Education</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {
            education.map((edu) => (
              <article class="resume-card">
                <h3 class="text-xl font-medium text-white">{edu.institution}</h3>
                <p class="text-[var(--gray-300)] mt-1">{edu.degree}</p>
                <p class="text-sm text-[var(--gray-500)] mt-3">
                  {edu.period} · {edu.gpa}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="mb-14">
        <h2 class="resume-label">Academic Projects</h2>
        <div class="space-y-4">
          {
            academicProjects.map((project) => (
              <article class="resume-card">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-3">
                  <h3 class="text-2xl font-medium text-white">{project.title}</h3>
                  <span class="text-sm text-[var(--gray-500)] whitespace-nowrap">{project.year}</span>
                </div>
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {project.tags.map((tag) => (
                    <span class="text-xs font-medium px-3 py-1 rounded-full border border-white/15 text-[var(--gray-300)]">
                      {tag}
                    </span>
                  ))}
                </div>
                <ul class="list-disc list-outside pl-5 space-y-2 text-[var(--gray-400)] marker:text-[var(--gray-600)]">
                  {project.descriptionPoints.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class="mb-14">
        <h2 class="resume-label">Technical Skills</h2>
        <div class="divide-y divide-white/10 border-y border-white/10">
          {
            skillGroups.map((group) => (
              <div class="grid sm:grid-cols-[9rem_1fr] gap-3 py-5">
                <h3 class="font-medium text-[var(--gray-300)]">{group.label}</h3>
                <div class="flex flex-wrap gap-1.5">
                  {group.items.map((item) => (
                    <span class="text-sm px-3 py-1 rounded-full border border-white/15 text-[var(--gray-200)]">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="resume-label">Research Papers</h2>
        <article class="resume-card">
          <h3 class="text-xl font-medium text-white">{researchPaper.title}</h3>
          <p class="text-[var(--gray-400)] italic mt-1">{researchPaper.authors}</p>
          <p class="text-sm text-[var(--gray-500)] mt-1">{researchPaper.conference}</p>
          <a
            href={researchPaper.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block mt-4 text-sm font-medium text-[var(--emerald-400)] hover:underline"
            >View on IEEE Xplore &nearr;</a
          >
        </article>
      </section>
    </main>

    <style>
      .resume-label {
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--emerald-400);
        margin-bottom: 1.25rem;
      }

      .resume-card {
        background: var(--gray-800);
        border: 1px solid rgb(255 255 255 / 0.1);
        border-radius: 28px;
        padding: 1.75rem;
      }

      .resume-pill {
        padding: 0.4rem 0.9rem;
        border-radius: 9999px;
        border: 1px solid rgb(255 255 255 / 0.15);
        color: var(--gray-300);
        transition: background-color 0.2s;
      }

      /* Printing from the browser still gives a clean black-on-white page. */
      @media print {
        .no-print {
          display: none !important;
        }
        body {
          background: #ffffff !important;
        }
        .resume-doc {
          padding-top: 0 !important;
          max-width: 100% !important;
        }
        .resume-doc * {
          color: #111 !important;
          border-color: #ccc !important;
        }
        .resume-card {
          background: none !important;
          border: none !important;
          padding: 0.5rem 0 !important;
        }
        .resume-label {
          color: #000 !important;
          border-bottom: 1px solid #999;
          padding-bottom: 0.25rem;
        }
      }
    </style>
  </body>
</html>
