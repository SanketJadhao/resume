---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeroSection from "../components/HeroSection.tsx";
import AboutSection from "../components/AboutSection.tsx";
import ExperienceSection from "../components/ExperienceSection.tsx";
import ProjectsSection from "../components/ProjectsSection.tsx";
import SkillsSection from "../components/SkillsSection.tsx";
import EducationSection from "../components/EducationSection.tsx";
import ContactSection from "../components/ContactSection.tsx";
import Footer from "../components/Footer.astro";

const pageTitle = "Sanket Jadhao - Resume Website";
const pageDescription =
  "Dark themed portfolio of Sanket Jadhao, showcasing skills in software development, blockchain, and machine learning.";
---

<Layout title={pageTitle} description={pageDescription}>
  <HeroSection client:load />
  <AboutSection client:visible />
  <ExperienceSection client:visible />
  <ProjectsSection client:visible />
  <SkillsSection client:visible />
  <EducationSection client:visible />
  <ContactSection client:visible />
</Layout>
